# Copy to backend/.env. Keep credentials out of Git.
AGENTGATE_ENV=development
AGENTGATE_OWNER_TOKEN=
AGENTGATE_IRIS_TOKEN=
AGENTGATE_NOVA_TOKEN=
DATABASE_URL=
AGENTGATE_DB_PATH=agentgate.db
PAYMENT_MODE=simulated
# Set PAYMENT_MODE=paypal only after adding your sandbox app credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
FRONTEND_URL=http://127.0.0.1:3000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=
# Optional Google Cloud Vertex AI (standard Vertex uses ADC/OAuth, not an AI Studio API key).
AGENTGATE_AI_PROVIDER=ollama
AGENTGATE_AI_MODEL=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=global
# Use a dedicated service account JSON only on hosted backends; never commit it.
VERTEX_AI_SERVICE_ACCOUNT_JSON=
